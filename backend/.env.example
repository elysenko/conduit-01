# Backend runtime configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1d
PORT=3000

# Admin-configurable service credentials (resolveConfig: env -> SystemSetting -> null)
MINIO_ENDPOINT=PLACEHOLDER_CONFIGURE_IN_SETTINGS
MINIO_ROOT_USER=PLACEHOLDER_CONFIGURE_IN_SETTINGS
MINIO_ROOT_PASSWORD=PLACEHOLDER_CONFIGURE_IN_SETTINGS
