# Backend runtime configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1d

# Must match colossus.yaml -> backend.port so the deploy agent's Service and
# health probes reach the process.
PORT=3001

# Optional: origin of the Angular SPA. CORS reflects the request origin by
# default, so this is informational only.
FRONTEND_URL=http://localhost:4200

# Admin-configurable service credentials.
# Resolution order is env -> SystemSetting row -> null (feature degrades with 503).
# Never required at boot: a missing key must not crash-loop the pod.
MINIO_ENDPOINT=PLACEHOLDER_CONFIGURE_IN_SETTINGS
MINIO_ACCESS_KEY=PLACEHOLDER_CONFIGURE_IN_SETTINGS
MINIO_SECRET_KEY=PLACEHOLDER_CONFIGURE_IN_SETTINGS
MINIO_BUCKET=conduit-media
